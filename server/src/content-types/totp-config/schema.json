{
  "kind": "collectionType",
  "collectionName": "magic_link_totp_configs",
  "info": {
    "singularName": "totp-config",
    "pluralName": "totp-configs",
    "displayName": "TOTP Configuration",
    "description": "Authenticator enrolments, namespaced by principal type (users-permissions user or admin user)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "principalType": {
      "type": "enumeration",
      "enum": ["users-permissions", "admin", "legacy"]
    },
    "principalKey": {
      "type": "string",
      "unique": true,
      "private": true
    },
    "userId": {
      "type": "integer",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "secret": {
      "type": "string",
      "private": true
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "algorithm": {
      "type": "string"
    },
    "digits": {
      "type": "integer"
    },
    "period": {
      "type": "integer"
    },
    "pending": {
      "type": "json",
      "private": true
    },
    "backupCodes": {
      "type": "json",
      "private": true
    },
    "backupCodesVersion": {
      "type": "integer",
      "private": true
    },
    "revision": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "lastUsed": {
      "type": "datetime"
    },
    "lastUsedStep": {
      "type": "integer",
      "private": true
    }
  }
}
