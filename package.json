{
  "version": "5.6.0",
  "keywords": [
    "strapi",
    "plugin",
    "strapi-plugin",
    "strapi-v5",
    "authentication",
    "passwordless",
    "magic-link",
    "magic-links",
    "email-auth",
    "otp",
    "totp",
    "mfa",
    "two-factor",
    "users-permissions",
    "login"
  ],
  "type": "commonjs",
  "exports": {
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "prebuild": "npm run lint",
    "build": "strapi-plugin build && npm run build:server && npm run copy:i18n && npm run verify:runtime",
    "build:server": "node scripts/build-server-bundle.mjs",
    "copy:i18n": "mkdir -p dist/server/i18n && cp -r server/src/i18n/*.json dist/server/i18n/",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "verify:runtime": "node scripts/verify-server-bundle.mjs",
    "lint": "eslint \"admin/**/*.{js,jsx}\" \"server/**/*.js\" \"strapi-server.js\" \"strapi-admin.js\"",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "speakeasy": "^2.0.0",
    "yup": "^1.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.57.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-link",
    "displayName": "Magic Link Authentication",
    "description": "Passwordless authentication for Strapi v5 via magic links, email OTP and TOTP-based MFA. Drop-in replacement for password login that works with the Users & Permissions plugin."
  },
  "name": "strapi-plugin-magic-link-v5",
  "description": "Passwordless authentication for Strapi v5 via magic links, email OTP and TOTP-based MFA. Drop-in replacement for password login.",
  "license": "MIT",
  "private": false,
  "author": "Schero A. <schero@magicdx.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schero94/strapi-plugin-magic-link-v5.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/strapi-plugin-magic-link-v5/issues"
  },
  "homepage": "https://github.com/Schero94/strapi-plugin-magic-link-v5#readme"
}
